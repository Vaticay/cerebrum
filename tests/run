/**
 * Security and privacy tests.
 *
 * These cover the behaviours where being wrong is expensive and where a
 * regression would be silent: forged sessions, cross-user access, and whether
 * a sensitive question can reach shared storage. They are unit tests against
 * the real modules — no server, no database, no network — so they run in a
 * second and can gate a build.
 *
 * Run with: npm test
 */

import { strict as assert } from "node:assert";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");

let passed = 0;
const failures = [];

async function test(name, fn) {
  try {
    await fn();
    passed++;
    console.log(`  ✓ ${name}`);
  } catch (e) {
    failures.push({ name, error: e });
    console.log(`  ✗ ${name}\n      ${e.message}`);
  }
}

function group(name) {
  console.log(`\n${name}`);
}

// ══════════════════════════════════════════════════════════════════════════
group("Query privacy — sensitive questions must never reach shared storage");

const { classifyQuery, cacheKey } = await import(join(root, "functions/lib/queryPrivacy.js"));

const MUST_NOT_PERSIST = [
  ["personal clinical",   "my son has a rash and fever, is it Kawasaki disease"],
  ["family health",       "interactions between sertraline and my mother chemotherapy"],
  ["self-harm topic",     "is suicide risk higher with isotretinoin"],
  ["stigmatised topic",   "HIV latency reversal agents"],
  ["unpublished work",    "our unpublished data shows GPR75 knockouts resist obesity"],
  ["medical record no.",  "patient MRN 4482119 presented with dyspnea"],
  ["email address",       "contact me at researcher@example.com about the trial"],
  ["first-person health", "why do I get migraines from red wine"],
  ["personal medication", "should I take metformin for prediabetes"],
  ["phone number",        "call 555-123-4567 about the cohort"],
];

for (const [label, q] of MUST_NOT_PERSIST) {
  await test(`refuses to persist: ${label}`, () => {
    const r = classifyQuery(q);
    assert.equal(r.persist, false, `classified persist=true (${r.reason})`);
    assert.equal(r.cacheable, false, `classified cacheable=true (${r.reason})`);
  });
}

const MUST_PERSIST = [
  "how does CRISPR gene editing work",
  "mechanisms of long term potentiation in the hippocampus",
  "waste oil substrates for black soldier fly larvae",
  "comparison of transformer and convolutional architectures",
];
for (const q of MUST_PERSIST) {
  await test(`allows caching: "${q.slice(0, 40)}…"`, () => {
    assert.equal(classifyQuery(q).persist, true);
  });
}

await test("cache key is not reversible to the query", async () => {
  const q = "how does CRISPR gene editing work";
  const k = await cacheKey(q, {});
  assert.ok(!k.includes("crispr"), "key contains the query text");
  assert.ok(!k.includes("gene"), "key contains the query text");
  assert.match(k, /^v8:[0-9a-f]{32}$/);
});

await test("cache key is stable across punctuation and case", async () => {
  const a = await cacheKey("How does CRISPR work?", {});
  const b = await cacheKey("how does crispr work", {});
  assert.equal(a, b);
});

await test("rotating the secret retires the cache", async () => {
  const a = await cacheKey("how does crispr work", { QUERY_KEY_SECRET: "one" });
  const b = await cacheKey("how does crispr work", { QUERY_KEY_SECRET: "two" });
  assert.notEqual(a, b);
});

// ══════════════════════════════════════════════════════════════════════════
group("Input validation");

const { cleanString, safeUrl, safeId, safeDataUrl, isValidEmail, escapeLike } =
  await import(join(root, "functions/lib/validate.js"));

await test("rejects javascript: URLs", () => assert.equal(safeUrl("javascript:alert(1)"), null));
await test("rejects data: URLs as links", () => assert.equal(safeUrl("data:text/html,<script>"), null));
await test("rejects URLs with embedded credentials", () =>
  assert.equal(safeUrl("https://apple.com@evil.example/"), null));
await test("accepts a normal https URL", () =>
  assert.ok(safeUrl("https://orcid.org/0000-0002-1825-0097")));
await test("strips bidi override characters", () => {
  const out = cleanString("ev‮liam‬", 40);
  assert.ok(!/[‪-‮⁦-⁩]/.test(out), "bidi characters survived");
});
await test("strips zero-width characters used to spoof handles", () => {
  assert.equal(cleanString("ad​min", 40), "admin");
});
await test("rejects a path-traversal id", () => assert.equal(safeId("../../etc/passwd"), null));
await test("accepts a generated id", () => assert.equal(safeId("thr_abc-123"), "thr_abc-123"));
await test("rejects HTML disguised as a PNG data URL", () =>
  assert.equal(safeDataUrl("data:image/png;base64,<script>", "image"), null));
await test("accepts a real PNG data URL", () =>
  assert.ok(safeDataUrl("data:image/png;base64,iVBORw0KGgo=", "image")));
await test("escapes SQL LIKE wildcards", () => assert.equal(escapeLike("100%_x"), "100\\%\\_x"));
await test("rejects malformed email", () => {
  assert.equal(isValidEmail("a@b"), false);
  assert.equal(isValidEmail("a b@c.co"), false);
  assert.equal(isValidEmail("a@b.co"), true);
});
await test("enforces length limits", () => {
  assert.equal(cleanString("x".repeat(500), 80).length, 80);
});

// ══════════════════════════════════════════════════════════════════════════
group("Origin policy");

const http = await import(join(root, "functions/lib/http.js"));
const req = (url, headers = {}) => new Request(url, { headers });

await test("trusts the canonical production origin", () =>
  assert.ok(http.isAllowedOrigin("https://askcerebrum.org", {})));
await test("rejects an unrelated origin", () =>
  assert.equal(http.isAllowedOrigin("https://evil.example", {}), false));
await test("rejects any other pages.dev project", () =>
  assert.equal(http.isAllowedOrigin("https://attacker.pages.dev", {}), false));
await test("accepts this project's preview subdomains", () =>
  assert.ok(http.isAllowedOrigin("https://feature-x.cerebrum-2pz.pages.dev", {})));
await test("previews can be disabled by the operator", () =>
  assert.equal(http.isAllowedOrigin("https://feature-x.cerebrum-2pz.pages.dev", { PREVIEW_ORIGINS: "off" }), false));

await test("localhost is trusted ONLY when we are served from localhost", () => {
  const localReq = req("http://localhost:8790/api/data");
  const prodReq = req("https://askcerebrum.org/api/data");
  assert.ok(http.isAllowedOrigin("http://localhost:8790", {}, localReq),
    "local origin rejected during local development");
  assert.equal(http.isAllowedOrigin("http://localhost:8790", {}, prodReq), false,
    "PRODUCTION ACCEPTED A LOCALHOST ORIGIN");
});

await test("write path refuses a request with no origin proof", () =>
  assert.equal(http.requireTrustedOrigin(req("https://askcerebrum.org/api/data"), {}), false));
await test("write path accepts a same-origin browser request", () =>
  assert.ok(http.requireTrustedOrigin(req("https://askcerebrum.org/api/data", { "Sec-Fetch-Site": "same-origin" }), {})));
await test("write path refuses a cross-site request", () =>
  assert.equal(http.requireTrustedOrigin(req("https://askcerebrum.org/api/data", { Origin: "https://evil.example", "Sec-Fetch-Site": "cross-site" }), {}), false));
await test("read path tolerates a missing origin", () =>
  assert.ok(http.readOriginAllowed(req("https://askcerebrum.org/api/data"), {})));
await test("CORS never reflects a disallowed origin", () => {
  const h = http.corsHeaders(req("https://askcerebrum.org/api/data", { Origin: "https://evil.example" }), {});
  assert.equal(h["Access-Control-Allow-Origin"], "https://askcerebrum.org");
  assert.equal(h["Access-Control-Allow-Credentials"], undefined,
    "credentials granted to a disallowed origin");
});

await test("rate-limit keys do not contain the raw IP", async () => {
  const k = await http.privacyKey("search", "203.0.113.7", {});
  assert.ok(!k.includes("203.0.113.7"), "raw IP present in the storage key");
  assert.match(k, /^search:[0-9a-f]{20}$/);
});
await test("X-Forwarded-For cannot move the rate-limit bucket", () => {
  const spoofed = req("https://askcerebrum.org/api/search", { "X-Forwarded-For": "1.2.3.4" });
  assert.equal(http.clientIp(spoofed), "unknown");
});

await test("oversized request bodies are refused before parsing", async () => {
  const big = new Request("https://askcerebrum.org/api/data", {
    method: "POST",
    headers: { "Content-Length": "9999999" },
    body: "{}",
  });
  const r = await http.readJsonBody(big, {}, 1000);
  assert.equal(r.ok, false);
  assert.equal(r.response.status, 413);
});
await test("a literal null body does not crash the handler", async () => {
  const r = await http.readJsonBody(new Request("https://askcerebrum.org/api/data", { method: "POST", body: "null" }), {});
  assert.equal(r.ok, true);
  assert.deepEqual(r.body, {});
});

// ══════════════════════════════════════════════════════════════════════════
group("Authentication — the forgeable-session class of bug");

const authSrc = stripComments(await (await import("node:fs/promises")).readFile(join(root, "functions/api/auth.js"), "utf8"));

await test("no unsigned fallback token minting remains", () => {
  assert.ok(!/function makeFallbackToken/.test(authSrc), "makeFallbackToken still exists");
  assert.ok(!/function readFallbackToken/.test(authSrc), "readFallbackToken still exists");
});
await test("no password login path remains", () => {
  assert.ok(!/action === "login"/.test(authSrc), "the login action is still dispatched");
  assert.ok(!/action === "signup"/.test(authSrc), "the signup action is still dispatched");
});
await test("auth fails closed without a database", () => {
  assert.match(authSrc, /if \(!env \|\| !env\.DB\)[\s\S]{0,400}503/,
    "no 503 fail-closed guard for a missing D1 binding");
});
await test("the plaintext OTP log is gone", () => {
  assert.ok(!/OTP_DEV_NO_RESEND/.test(authSrc), "codes are still logged in plaintext");
});
await test("a missing email provider fails closed", () => {
  assert.match(authSrc, /RESEND_API_KEY[\s\S]{0,600}return false/,
    "sendOtpEmail still returns success when it cannot send");
});
await test("logout revokes the server-side session", () => {
  assert.match(authSrc, /destroySessionByToken/, "logout does not destroy the session");
  assert.match(authSrc, /bumpSessionEpoch/, "logout does not invalidate stateless tokens");
});
await test("account deletion covers messages, follows and blocks", () => {
  for (const table of ["messages", "thread_participants", "follows", "user_blocks", "watched_topics", "call_signals"]) {
    assert.ok(authSrc.includes(table), `delete-account does not touch ${table}`);
  }
});

const helpersSrc = stripComments(await (await import("node:fs/promises")).readFile(join(root, "functions/lib/authHelpers.js"), "utf8"));
await test("JWT algorithm and type are pinned", () => {
  assert.match(helpersSrc, /header\.alg !== "HS256"/, "alg is not pinned");
  assert.match(helpersSrc, /header\.typ !== "JWT"/, "typ is not pinned");
});
await test("JWT expiry is required, not optional", () => {
  assert.match(helpersSrc, /typeof payload\.exp !== "number"/,
    "a token with no exp claim would be treated as valid forever");
});
await test("revocation state failure fails closed", () => {
  assert.match(helpersSrc, /MAX_SAFE_INTEGER[\s\S]{0,80}tombstoned: true/,
    "an unreadable epoch would be treated as 'not revoked'");
});
await test("OTP codes are hashed under a server secret", () => {
  assert.match(helpersSrc, /export async function hashOtp/, "no keyed OTP hash");
});

// ══════════════════════════════════════════════════════════════════════════
group("Authorization — cross-user access");

/* Comments are stripped before matching. Several of these files explain, in
 * prose, the vulnerability they fixed — a naive search finds the explanation
 * and reports the documentation as the bug. */
function stripComments(src) {
  return src.replace(/\/\*[\s\S]*?\*\//g, "").replace(/(^|[^:])\/\/[^\n]*/g, "$1");
}
const dataSrc = stripComments(await (await import("node:fs/promises")).readFile(join(root, "functions/api/data.js"), "utf8"));

await test("thread reads require membership", () => {
  assert.match(dataSrc, /SELECT 1 FROM thread_participants WHERE thread_id = \? AND user_id = \?/,
    "no membership check before returning messages");
});
await test("reporting someone requires a real relationship", () => {
  assert.match(dataSrc, /no_relationship/, "any user can report any user id");
});
await test("follow respects blocks", () => {
  const follow = dataSrc.slice(dataSrc.indexOf('action === "toggle-follow"'), dataSrc.indexOf('action === "send-message"'));
  assert.match(follow, /isBlockedPair/, "a blocked user can still follow");
});
await test("hidden and missing accounts are indistinguishable", () => {
  assert.ok(!/That account doesn't exist\./.test(dataSrc),
    "a distinct 404 message still confirms whether an account id is real");
});
await test("attachment URLs go through the URL validator", () => {
  assert.match(dataSrc, /const attachmentUrl = safeUrl\(/,
    "attachment_url is stored without scheme validation");
});
await test("the founder's identity is not published to other accounts", () => {
  const fs2 = dataSrc.slice(dataSrc.indexOf('resource === "founder-status"'));
  assert.ok(!/matchedUser,/.test(fs2.slice(0, 2000)),
    "founder-status still returns the founder's username to any signed-in user");
});
await test("no email address is selected into social payloads", () => {
  assert.ok(!/SELECT u\.id, u\.name, u\.username, u\.email FROM thread_participants/.test(dataSrc),
    "the inbox query still selects email");
  assert.ok(!/caller\.email/.test(dataSrc),
    "incoming-calls still falls back to the caller's email address");
});

const iceSrc = stripComments(await (await import("node:fs/promises")).readFile(join(root, "functions/api/iceservers.js"), "utf8"));
await test("TURN credentials require a session", () => {
  assert.match(iceSrc, /getSessionUser/, "TURN credentials are minted for anonymous callers");
  assert.match(iceSrc, /checkRateLimit/, "TURN credential minting is unthrottled");
});

const reportSrc = stripComments(await (await import("node:fs/promises")).readFile(join(root, "functions/api/report.js"), "utf8"));
await test("the report endpoint enforces its origin allowlist", () => {
  assert.match(reportSrc, /requireTrustedOrigin/, "report.js defines an allowlist it never enforces");
});
await test("reports do not store a raw IP alongside the query", () => {
  assert.ok(!/CF-Connecting-IP"\) \|\| "unknown"\s*\)\s*\n\s*\.run\(\)/.test(reportSrc));
  assert.match(reportSrc, /privacyKey\("reporter"/, "reporter IP is not hashed");
});

// ══════════════════════════════════════════════════════════════════════════
group("AI safety — prompt injection and citation integrity");

const searchSrc = stripComments(await (await import("node:fs/promises")).readFile(join(root, "functions/api/search.js"), "utf8"));

await test("retrieved source text is fenced with a per-request nonce", () => {
  assert.match(searchSrc, /function makeFence/, "no fencing of untrusted content");
  assert.match(searchSrc, /fence\.clean\(p\.title\)/, "paper titles are not sanitised");
  assert.match(searchSrc, /fence\.clean\(fullAbstract|fence\.clean\(cappedAbstract/, "abstracts are not sanitised");
});
await test("the question is stated outside the source fence", () => {
  assert.match(searchSrc, /fence\.open \+ "\\n" \+ evidence \+ \(briefSection \? "\\n\\n" \+ briefSection : ""\) \+ "\\n" \+ fence\.close/,
    "evidence and question are still concatenated into one blob");
  // The brief is untrusted model output: it must live INSIDE the fence (data),
  // never outside it where it could speak as instruction — and the ACTUAL
  // brief text must reach wave 2, not just the explanatory prose. (A prior
  // version checked the brief's presence but dropped its content, so wave 2
  // composed from prose about claims rather than the claims themselves.)
  assert.match(searchSrc, /fence\.clean\(brief\)/, "wave 2 never receives the actual brief text");
  assert.match(searchSrc, /briefSection\s*=\s*\n?\s*"EVIDENCE BRIEF/, "brief section is not built through the fenced content builder");
});
await test("our own annotation markers cannot be forged by a source", () => {
  assert.match(searchSrc, /RETRACTED\|WRONG SPECIES/, "reserved markers are not stripped from source text");
});
await test("citations are validated against real authors, not just a range", () => {
  assert.match(searchSrc, /knownAuthors/, "author-year attributions are not checked");
});
await test("raw queries are no longer written to query_intelligence", () => {
  assert.match(searchSrc, /VALUES \(\?, NULL, \?/, "raw_query is still persisted");
});
await test("provider error bodies are not returned to ordinary callers", () => {
  assert.match(searchSrc, /async function operatorDiagnostics/, "diagnostics are not gated");
  assert.ok(!/_aiAttempts: typeof aiAttempts/.test(searchSrc),
    "_aiAttempts still ships on every response");
});

// ══════════════════════════════════════════════════════════════════════════
group("Retention");

const { RETENTION, sweepExpiredData } = await import(join(root, "functions/lib/retention.js"));
await test("every retained table has a defined window", () => {
  for (const k of ["answerCacheMs", "paperCacheMs", "queryIntelligenceMs", "callSignalsMs", "otpMs", "magicLinkMs"]) {
    assert.ok(RETENTION[k] > 0, `${k} has no retention window`);
  }
});
await test("sweep is a no-op without a database rather than throwing", async () => {
  const r = await sweepExpiredData({});
  assert.equal(r.swept, 0);
});

// ══════════════════════════════════════════════════════════════════════════
group("Wave 4 — deterministic extractive synthesis (total AI outage fallback)");

const { buildExtractiveSynthesis } = await import(join(root, "functions/api/search.js"));

const NO_ABSTRACT_PAPERS = [
  { title: "Fine-scale population structure, inbreeding risk and avoidance in a wild insect population", journal: "Molecular Ecology", year: "2011", abstract: "No abstract available." },
  { title: "Prairie Dogs Avoid Extreme Inbreeding", journal: "Science", year: "1982", abstract: "No abstract available." },
  { title: "Gene drive escape from resistance depends on mechanism and ecology.", journal: "Evolutionary applications", year: "2022", abstract: "No abstract available." },
  { title: "Kin recognition and incest avoidance in a group-living insect", journal: "Behavioral Ecology", year: "2007", abstract: "No abstract available." },
];

const ABSTRACT_PAPERS = [
  { title: "Gut microbiome shifts during larval development", journal: "Microbiome", year: "2023",
    abstract: "We found that early instars were dominated by Proteobacteria (62%), while late instars shifted toward Firmicutes (58%, p < 0.01). Diet significantly altered community composition." },
  { title: "Dietary protein shapes the gut microbiota", journal: "Animal Microbiome", year: "2024",
    abstract: "We demonstrate that high-protein diets increase Bacteroidetes abundance 3-fold. Larvae showed 24% faster growth." },
  { title: "Quantum tunneling in photosynthetic reaction centers", journal: "Nature Physics", year: "2022",
    abstract: "We report evidence of quantum coherence at room temperature. The observed transfer efficiency reached 97%." },
];

await test("title-only papers produce a labeled synthesis, not the dead-end fallback", () => {
  const out = buildExtractiveSynthesis(NO_ABSTRACT_PAPERS);
  assert.ok(out && out.length > 200, "no synthesis produced");
  assert.ok(!/Unable To Synthesize/i.test(out), "dead-end fallback text leaked through");
  assert.ok(/^## The short answer/m.test(out), "missing overview heading");
  assert.ok(/Drafted directly from the sources/i.test(out), "missing honesty label");
  for (let n = 1; n <= 4; n++) assert.ok(out.includes("[" + n + "]"), `missing citation [${n}]`);
  assert.ok(out.includes("Molecular Ecology, 2011"), "venue metadata missing");
});

await test("papers with abstracts get clustered themes and extracted findings", () => {
  const out = buildExtractiveSynthesis(ABSTRACT_PAPERS);
  assert.ok(out.includes("### "), "no theme sections produced");
  // The two microbiome papers share vocabulary and must cluster apart from physics.
  assert.ok(/Gut ·|Microbiome|Larval/i.test(out), "microbiome theme missing");
  assert.ok(/Quantum/i.test(out), "physics theme missing");
  assert.ok(out.includes("**62%**"), "quantities are not bolded");
  assert.ok(out.includes("**p < 0.01**"), "p-value was mangled by sentence splitting");
});

await test("returns null when there is nothing to synthesize from", () => {
  assert.equal(buildExtractiveSynthesis([]), null);
  assert.equal(buildExtractiveSynthesis(null), null);
  assert.equal(buildExtractiveSynthesis(undefined), null);
  assert.equal(buildExtractiveSynthesis([{ title: "", abstract: "" }]), null);
});

await test("never throws on malformed input", () => {
  assert.doesNotThrow(() => buildExtractiveSynthesis([{ title: null, abstract: 42 }]));
  assert.doesNotThrow(() => buildExtractiveSynthesis("not an array"));
  assert.doesNotThrow(() => buildExtractiveSynthesis([{ abstract: "We found X increased 3-fold (p < 0.05)." }]));
});

await test("citation indices stay 1-based and aligned to input order", () => {
  const out = buildExtractiveSynthesis(ABSTRACT_PAPERS);
  // Every citation must reference a real input position — no [0], no [4+].
  const cites = [...out.matchAll(/\[(\d+)\]/g)].map((m) => parseInt(m[1], 10));
  assert.ok(cites.length > 0, "no citations emitted");
  for (const n of cites) assert.ok(n >= 1 && n <= ABSTRACT_PAPERS.length, `dangling citation [${n}]`);
});

await test("wave 4 is wired into the search handler before the honest fallback", () => {
  assert.match(searchSrc, /buildExtractiveSynthesis\(extPool, briefClaims, \{/, "wave 4 is not attempted on total AI failure");
  assert.match(searchSrc, /if \(!extractiveOK\)/, "no-results terminal state missing when extractive synthesis has nothing to work with");
  assert.match(searchSrc, /responseKind = "no-results"/, "no-results response kind not set");
  assert.match(searchSrc, /synthesisMode: extractiveOK \? "extractive"/, "synthesisMode is not reported to the frontend");
});

// ══════════════════════════════════════════════════════════════════════════
group("Evidence brief — speculative claim extraction");

const { parseClaimLines, buildEvidenceBrief } = await import(join(root, "functions/api/search.js"));

await test("parseClaimLines extracts dash-led claims and skips junk", () => {
  const raw = "Here are the key findings:\n- Inbreeding depression reduced fitness by 34% in the study population.\n- Prairie dogs avoided mating with close kin in 92% of observed pairings.\n1. Kin recognition was mediated by odor cues in the trials.\nToo short.\n- " + "x".repeat(500);
  const claims = parseClaimLines(raw);
  assert.equal(claims.length, 3);
  assert.ok(claims[0].includes("34%"), "first claim mangled");
  assert.ok(claims[2].includes("odor cues"), "numbered claim not parsed");
});

await test("parseClaimLines never throws on garbage", () => {
  assert.doesNotThrow(() => parseClaimLines(null));
  assert.doesNotThrow(() => parseClaimLines(42));
  assert.deepEqual(parseClaimLines(""), []);
});

await test("buildEvidenceBrief clusters claims into themes with citations", () => {
  const papers = [
    { title: "Inbreeding avoidance in wild insects", abstract: "abc" },
    { title: "Kin recognition in prairie dogs", abstract: "def" },
    { title: "Quantum tunneling in photosynthesis", abstract: "ghi" },
  ];
  const claimLists = [
    ["Inbreeding depression reduced fitness by 34% in the wild insect population studied."],
    ["Prairie dogs avoided mating with close kin in 92% of observed pairings in the field study."],
    ["Quantum coherence was observed at room temperature with 97% transfer efficiency in the experiment."],
  ];
  const { text, claims } = buildEvidenceBrief(papers, claimLists);
  assert.ok(text.length > 100, "brief text too short");
  assert.ok(text.includes("[1]") && text.includes("[2]") && text.includes("[3]"), "citations missing");
  assert.ok(text.includes("34%"), "claim content missing");
  assert.ok(/^EVIDENCE BRIEF/.test(text), "brief header missing");
  assert.equal(claims.length, 3);
  assert.ok(claims.every((c) => c.idx >= 1 && c.idx <= 3), "claim citation out of range");
});

await test("buildEvidenceBrief merges near-duplicate claims across papers", () => {
  const papers = [{ title: "A", abstract: "x" }, { title: "B", abstract: "y" }];
  const claimLists = [
    ["High-protein diets increased Bacteroidetes abundance 3-fold in the larval gut."],
    ["A high-protein diet increased Bacteroidetes abundance threefold in larval guts."],
  ];
  const { text } = buildEvidenceBrief(papers, claimLists);
  // Merged: one line carrying both citations.
  assert.ok(/\[1\]\[2\]/.test(text), "duplicate claims were not merged with combined citations");
});

await test("buildEvidenceBrief returns empty when too few claims", () => {
  assert.deepEqual(buildEvidenceBrief([], []), { text: "", claims: [] });
  assert.deepEqual(buildEvidenceBrief([{ title: "A" }], [[]]), { text: "", claims: [] });
  assert.deepEqual(buildEvidenceBrief(null, null), { text: "", claims: [] });
});

await test("wave 4 prefers brief claims over regex sentences", () => {
  const out = buildExtractiveSynthesis(ABSTRACT_PAPERS, [
    { text: "Brief-extracted claim about microbiome shifts with 62% Proteobacteria dominance.", idx: 1 },
  ]);
  assert.ok(out.includes("Brief-extracted claim"), "brief claim not preferred in fallback");
  assert.ok(out.includes("[1]"), "brief claim citation missing");
});

await test("evidence brief is launched before wave 1 and consumed by waves 2+", () => {
  assert.match(searchSrc, /briefPromise/, "speculative brief launch missing");
  assert.match(searchSrc, /buildBriefMessages\(briefText\)/, "wave 2 does not consume the brief");
  assert.match(searchSrc, /EVIDENCE BRIEF \(pre-extracted claims — lead with these/, "wave 3 does not consume the brief");
  assert.match(searchSrc, /Promise\.any\(legs\)/, "extraction has no provider race");
});
await test("speculative brief fan-out is capped and wave 2 waits boundedly", () => {
  // The brief must not drain the rate-limit buckets waves 1-3 need:
  // capped papers and a small fixed leg count.
  assert.match(searchSrc, /evidencePapers\.slice\(0, 3\)/, "brief paper fan-out is not capped");
  assert.ok(!/activeProviders\.slice\(0, 2\)/.test(searchSrc), "brief still fans out across multiple provider legs");
  // A fast-failing wave 1 must not outrun the extraction: bounded await
  // before wave-2 messages are built.
  assert.match(searchSrc, /Promise\.race\(\[\s*briefPromise/, "wave 2 does not take a bounded await on the brief");
});
await test("Turn is memoized with stabilized per-turn callbacks", async () => {
  const appSrc = (await (await import("node:fs/promises")).readFile(join(root, "src/CerebrumApp.jsx"), "utf8"));
  assert.match(appSrc, /const Turn = React\.memo\(TurnInner\)/, "Turn is not wrapped in React.memo");
  assert.match(appSrc, /askRef\.current/, "per-turn callbacks do not read through a stable ask ref");
  assert.match(appSrc, /<TurnRow key=\{t\.id \?\? ti\}/, "turn list does not render the stabilized TurnRow");
  assert.ok(!/onStress=\{\(o\) => ask\(t\.q, o\)\}/.test(appSrc), "unstable inline onStress still passed per render");
});
await test("a11y: skip link, main landmark, input names, SVG roles, abort", async () => {
  const appSrc = (await (await import("node:fs/promises")).readFile(join(root, "src/CerebrumApp.jsx"), "utf8"));
  assert.match(appSrc, /className="cb-skip-link"/, "skip link missing");
  assert.match(appSrc, /<main id="cb-main" ref=\{mainRef\}/, "main landmark missing");
  assert.match(appSrc, /useEffect\(\(\) => \{\s*if \(viewFirstRef\.current\)/, "view-change focus move missing");
  assert.ok(!/<(?:input|textarea|button|select|a)\b[^>]*ariaLabel=/.test(appSrc), "invalid ariaLabel prop on a native element (must be aria-label)");
  assert.ok(!/role="button"\s*\n\s*aria-label=\{\s*label\s*\}/.test(appSrc), "SVG node still claims role=button with no activation");
  assert.match(appSrc, /askAbortRef\.current\?\.abort\(\)/, "superseded searches are not aborted");
  assert.match(appSrc, /signal: askCtrl\.signal/, "abort signal not passed to search fetch");
  assert.match(appSrc, /cbMotionCacheBust/, "motion-preference cookie reads are not cached");
});
await test("film survives iOS autoplay policies (Low Power Mode)", async () => {
  const appSrc = (await (await import("node:fs/promises")).readFile(join(root, "src/CerebrumApp.jsx"), "utf8"));
  // The Play control must issue play() synchronously inside the tap's gesture
  // window — a play() from the post-setState effect is vetoed by iOS Low
  // Power Mode, which is exactly the "clips aren't playing" report.
  assert.match(appSrc, /forwardRef\(function CinematicFilm/, "CinematicFilm does not forward a ref");
  assert.match(appSrc, /playNow: \(\) =>/, "no gesture-context playNow exposed");
  assert.match(appSrc, /filmRef\.current\?\.playNow\(\)/, "Play control does not call playNow in the gesture");
  // First interaction retries the reel: a phone that vetoed programmatic
  // autoplay gets footage on first tap instead of a still poster all visit.
  assert.match(appSrc, /window\.addEventListener\("pointerdown", tryResume\)/, "first-gesture film resume missing");
  assert.match(appSrc, /window\.removeEventListener\("pointerdown", tryResume\)/, "gesture resume listener leaks");
  // A vetoed play surfaces a tap-to-play affordance instead of silence.
  assert.match(appSrc, /onAutoplayBlocked/, "autoplay-blocked notification missing");
  assert.match(appSrc, /Background film paused — tap to play/, "tap-to-play pill missing");
});
await test("search loader: 10s comet orbit, tick ring, honest clock", async () => {
  const appSrc = (await (await import("node:fs/promises")).readFile(join(root, "src/CerebrumApp.jsx"), "utf8"));
  // The master visual interval is 10 seconds — never the old 8s loop.
  assert.match(appSrc, /animation: cbTxOrbit 10s linear infinite/, "comet is not on the 10-second master interval");
  assert.ok(!/cbTxOrbit 8s/.test(appSrc), "an 8-second orbit survived somewhere");
  // The instrument's moving parts all exist and are keyed.
  for (const name of ["cbTxOrbitRev", "cbTxPing", "cbTxTick", "cbTxTwinkle", "cbTxBreathe"]) {
    assert.match(appSrc, new RegExp(`@keyframes ${name}`), `missing @keyframes ${name}`);
  }
  assert.match(appSrc, /for \(let i = 0; i < 60; i\+\+\)/, "60-tick chronometer ring missing");
  assert.match(appSrc, /cb-tx-ping-b/, "staggered second sonar ping missing");
  assert.match(appSrc, /cb-tx-comet/, "comet group missing");
  // The one honest number is untouched: real elapsed seconds in the center.
  assert.match(appSrc, /cb-tx-clock/, "elapsed clock missing from the loader");
  assert.match(appSrc, /Math\.floor\(elapsed \/ 1000\)/, "clock is not driven by real elapsed time");
  // Reduced motion parks the whole instrument, new parts included.
  assert.match(appSrc, /\.cb-tx-comet, \.cb-tx-ping, \.cb-tx-inner-orbit,\n\s+\.cb-tx-clock, \.cb-tx-dot, \.cb-tx-state \{ animation: none; \}/,
    "reduced-motion does not silence the new loader animations");
});
await test("search errors carry a diagnostic caption and the request is bounded", async () => {
  const appSrc = (await (await import("node:fs/promises")).readFile(join(root, "src/CerebrumApp.jsx"), "utf8"));
  // Every failure path stamps a diagnostic: HTTP status or failure class,
  // elapsed seconds, wall-clock time. The user-facing copy stays plain.
  assert.match(appSrc, /setErrorDetail\(`HTTP \$\{res\.status\} ·/, "non-2xx path lacks a diagnostic caption");
  assert.match(appSrc, /setErrorDetail\(`unparseable body/, "bad-body path lacks a diagnostic caption");
  assert.match(appSrc, /setErrorDetail\(`network ·/, "network-failure path lacks a diagnostic caption");
  assert.match(appSrc, /setErrorDetail\(`timeout ·/, "timeout path lacks a diagnostic caption");
  assert.match(appSrc, /\{errorDetail &&/, "error card does not render the diagnostic caption");
  // The request can never spin forever on a stalled connection.
  assert.match(appSrc, /askCtrl\.abort\("timeout"\)/, "no client-side search timeout");
  assert.match(appSrc, /clearTimeout\(askTimeout\)/, "search timeout is not cleared on completion");
});
await test("modal scroll lock is keyed on the overlay boolean, not each overlay", async () => {
  const appSrc = (await (await import("node:fs/promises")).readFile(join(root, "src/CerebrumApp.jsx"), "utf8"));
  // The pin/restore effect must run once per open-session: keying it on the
  // individual overlay states re-pinned on every nested open/close and read
  // a stale scrollY on iOS, sending the page rogue.
  assert.match(appSrc, /const anyOverlayOpen = cmdOpen \|\| howItWorksOpen \|\| mobilePanel/, "anyOverlayOpen boolean missing");
  assert.match(appSrc, /\}, \[anyOverlayOpen\]\);/, "scroll-lock effect is not keyed on the single overlay boolean");
  assert.ok(!/}, \[cmdOpen, howItWorksOpen, mobilePanel, authOpen, collectionsOpen, compareOpen, networkGraphSources, timelineSources, evidenceTableSources, importPrompt, drawerSource\]\);/.test(appSrc),
    "scroll-lock effect still re-runs per overlay");
});
await test("vote/report UI is honest about the auth requirement", async () => {
  const appSrc = (await (await import("node:fs/promises")).readFile(join(root, "src/CerebrumApp.jsx"), "utf8"));
  // Votes: a 401 must not be thanked for.
  assert.match(appSrc, /r\.status === 401 \? "Sign in to have your vote counted\."/, "vote 401 feedback missing");
  // Report: anonymous users are routed to sign-in before the modal opens.
  assert.match(appSrc, /onRequireAuth=\{stableOnRequireAuth\}/, "onRequireAuth not wired to TurnRow");
  assert.match(appSrc, /if \(user\) setShowReport\(true\); else onRequireAuth\(\)/, "report button not gated on sign-in");
});
