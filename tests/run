// ══════════════════════════════════════════════════════════════════════════
// Worker-owned suites (backend overhaul passes): each is a standalone
// script with its own assertions; run them as child processes so a
// failure here fails the whole suite.
for (const suite of ["auth-security.mjs", "content-endpoints.mjs", "media-resilience.mjs", "shared-libs.mjs", "answer-insights.mjs", "css-keyframes.mjs", "fc-label.mjs", "answer-experience.mjs", "scope-audit.mjs", "export-excel.mjs", "favicon.mjs", "answer-engine.mjs", "intro-title-card.mjs", "answer-ship.mjs", "flashpoint-fix.mjs"]) {
  await test(`suite ${suite}`, async () => {
    const { execFile } = await import("node:child_process");
    await new Promise((resolve, reject) => {
      execFile(process.execPath, [join(root, "tests", suite)], { timeout: 60000 }, (err, stdout, stderr) => {
        if (stdout) console.log(stdout.trim().split("\n").map((l) => "    " + l).join("\n"));
        if (err) reject(new Error(`${suite} failed:\n${stderr || err.message}`));
        else resolve();
      });
    });
  });
}

// ══════════════════════════════════════════════════════════════════════════
console.log(`\n${passed} passed, ${failures.length} failed`);
if (failures.length) process.exit(1);
