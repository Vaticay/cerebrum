# Cerebrum response headers.
#
# THIS FILE MUST LIVE IN public/. It used to sit at the repository root, and
# Vite only copies public/ into dist/ — so Cloudflare Pages never saw it and
# not one header below was ever served. Confirmed against production: the live
# site returned no CSP, no HSTS and no X-Frame-Options. Everything here was
# written, reviewed and shipped to nobody.
#
# If you move this file, verify with:  curl -sI https://askcerebrum.org/

/*
  # Clickjacking. frame-ancestors is the modern control and CSP carries it;
  # X-Frame-Options stays for older engines that ignore CSP.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

  # Two years, subdomains included, preload-eligible.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # microphone/camera are self-allowed because calls need them; everything
  # else is denied outright rather than left to the browser's default.
  Permissions-Policy: accelerometer=(), autoplay=(self), browsing-topics=(), camera=(self), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(self), midi=(), payment=(), usb=(), xr-spatial-tracking=()

  # ── Content Security Policy ────────────────────────────────────────────
  # Written against what the application actually does at runtime, not against
  # a list of hosts someone once needed. Three notes on the tightening:
  #
  # script-src is 'self' with NO 'unsafe-inline' and NO 'unsafe-eval', and
  # there are no inline scripts left to need it (the font stylesheet's
  # onload="this.media='all'" handler was removed — it would have been blocked
  # here and left the site unstyled). worker-src is declared explicitly for
  # the pdf.js worker, which is now bundled from this origin instead of
  # fetched from cdn.jsdelivr.net; without that directive it would fall back
  # to default-src and PDF reading would break.
  #
  # style-src keeps 'unsafe-inline'. This is not laziness: the application
  # styles nearly everything through React inline style props, so removing it
  # is a full rewrite of the styling layer rather than a header change. It is
  # the one weakness left in this policy and it is stated rather than hidden.
  #
  # connect-src is now short. The scholarly databases and AI providers are
  # called from the server, never the browser, so the long allowlist of
  # ebi.ac.uk / ncbi / openalex / crossref / arxiv / pollinations hosts was
  # granting the page permissions it never used. What remains is our own API
  # plus the two services a user can opt into with their own key.
  #
  # img-src keeps https: because figures, journal covers and press images come
  # from many scholarly hosts that cannot be enumerated in advance. Narrowing
  # this would require proxying every image through our own origin — worth
  # doing, not done here.
  Content-Security-Policy: default-src 'none'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://api.elevenlabs.io https://api.zotero.org; media-src 'self' data: blob: https:; frame-src https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests

  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Content-hashed build output. Safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts are content-hashed by Google's own filenames and never
# change in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-32x32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400

# API responses are per-user. They must never be stored by a shared cache,
# and they are not documents, so framing and sniffing protections apply here
# too rather than being inherited by luck.
/api/*
  Cache-Control: no-store, private
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# The HTML shell changes every deploy. Revalidate rather than serve a stale
# document that references assets which no longer exist.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The root path serves the same HTML shell as /index.html — it gets the same
# rule, stated explicitly rather than inherited by luck.
/
  Cache-Control: public, max-age=0, must-revalidate
