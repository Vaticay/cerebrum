{
  "name": "cerebrum",
  "version": "6.20.0",
  "description": "A free scientific literature search engine \u2014 ask a research question, get a cited answer synthesized from open scholarly databases.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vaticay/cerebrum"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --proxy 5173 -- vite",
    "vite": "vite",
    "prebuild": "node scripts/write-version.mjs",
    "build": "vite build && node scripts/prerender.mjs && node scripts/check.mjs",
    "preview": "wrangler pages dev ./dist",
    "deploy": "vite build && wrangler pages deploy ./dist",
    "test": "node tests/run",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8",
    "wrangler": "^3.78.0"
  }
}
