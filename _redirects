# Cloudflare Pages redirects: map clean info-page URLs to their HTML files.
# Scanners crawl these URLs directly — having them respond 200 instead of
# 404 (or falling through to the SPA) is essential for correct categorization.
/about       /about.html       200
/privacy     /privacy.html     200
/terms       /terms.html       200
/contact     /contact.html     200

# Any other unmatched route falls through to the SPA (React handles routing).
/*           /index.html       200
